		<Endianess>BigEndian</Endianess>
	</IntReg>

	<Enumeration Name="PtpStatus" NameSpace="Standard">
		<EnumEntry Name="Slave" NameSpace="Standard">
			<Value>0</Value>
		</EnumEntry>
		<EnumEntry Name="Off" NameSpace="Standard">
			<Value>1</Value>
		</EnumEntry>
		<EnumEntry Name="Initializing" NameSpace="Standard">
			<Value>2</Value>
		</EnumEntry>
		<EnumEntry Name="Faulty" NameSpace="Standard">
			<Value>3</Value>
		</EnumEntry>
		<EnumEntry Name="Disabled" NameSpace="Standard">
			<Value>4</Value>
		</EnumEntry>
		<EnumEntry Name="Listening" NameSpace="Standard">
			<Value>5</Value>
		</EnumEntry>
		<EnumEntry Name="PreMaster" NameSpace="Standard">
			<Value>6</Value>
		</EnumEntry>
		<EnumEntry Name="Master" NameSpace="Standard">
			<Value>7</Value>
		</EnumEntry>
		<EnumEntry Name="Passive" NameSpace="Standard">
			<Value>8</Value>
		</EnumEntry>
		<EnumEntry Name="Uncalibrated" NameSpace="Standard">
			<Value>9</Value>
		</EnumEntry>
		<pValue>PtpStatusRegister</pValue>
