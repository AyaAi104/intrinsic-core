id {
  package: "ai.intrinsic"
  name: "collect_calibration_data"
}
display_name: "Collect calibration data"
vendor {
  display_name: "Intrinsic"
}
documentation {
  description:
  "The `collect_calibration_data` skill automates the process of capturing data points for calibration.\n"
  "It iterates through a provided list of robot waypoints. At each waypoint, it performs the following steps:\n"
  "  1. Directly plans and executes the motion to the target pose.\n"
  "  2. Waits for motion to settle and senses the actual joint positions from the motor-encoders.\n"
  "  3. Calls `CaptureData` on the unified `CalibrationService`, passing the sensed robot pose. The service handles\n"
  "     image acquisition and pattern detection.\n"
  "  4. Optionally, returns the robot to a safe initial position before proceeding to avoid collisions (if requested).\n"
  "\n"
  "The data collection can be performed with collision detection or without.\n"
  "The mode without collision detection is useful when the model of the world\n"
  "is not accurate, but we are still certain that the provided waypoints can\n"
  "be safely reached.\n"
}
extended_documentation {
  prerequisites:
  "Before running `collect_calibration_data`, make sure the robot is in a collision-free "
  "configuration.\n"
  "\n"
  "Additionally, a calibration session must have been initialized in the `CalibrationService` "
  "by calling the `initialize_calibration` skill. This setup step ensures that the service is ready "
  "to collect data points that will be later used for intrinsic, camera-to-robot and/or "
  "camera-to-camera calibration.\n"
  "\n"
  "Optionally, if you wish to apply a pseudo-random sampling strategy for selecting waypoints, "
  "you can call the `sample_calibration_poses` skill to generate the waypoints passed to "
  "`collect_calibration_data`."
}
options {
  supports_cancellation: true
  cancellation_ready_timeout {
    seconds: 30
  }
  cc_config {
    create_skill: "::intrinsic::skills::CollectCalibrationData::CreateSkill"
  }
}
parameter {
  message_full_name: "intrinsic_proto.skills.CollectCalibrationDataParams"
  default_value {
    [type.googleapis.com/intrinsic_proto.skills.CollectCalibrationDataParams] {
      disable_collision_checking: false
    }
  }
}
return_type {
  message_full_name: "intrinsic_proto.skills.CollectCalibrationDataResult"
}
