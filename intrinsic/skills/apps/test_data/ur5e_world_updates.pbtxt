updates {
  add_label {
    entities {
      by_labels {
        label_ids: "my_robot"
        entity_name: "wrist_3_link"
      }
    }
    labels_to_add: "tip"
    labels_to_add: "gripper"
  }
}

updates {
  set_robot_tip {
    robot_name: "my_robot"
    tip_entity {
      by_labels {
        label_ids: "my_robot"
        entity_name: "wrist_3_link"
      }
    }
  }
}

updates {
  self_exclusions {
    robot_id: "my_robot"
  }
}

updates {
  set_object_names {
    models_to_objects {
      sdf_model_name: "my_robot"
      object_name: "my_robot"
    }
  }
}

updates {
  set_robot_ik_solver_key {
    entities {
      # Collections entity of robot.
      by_labels: {
        label_ids: "my_robot"
        entity_name: "base_link"
      }
    }
    solver_key: "ur"
    override_tip_entity: {
      by_labels {
        label_ids: "my_robot"
        entity_name: "wrist_3_link"
      }
    }
  }
}

