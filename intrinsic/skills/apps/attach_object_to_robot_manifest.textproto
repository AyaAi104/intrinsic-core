id {
  package: "ai.intrinsic"
  name: "attach_object_to_robot"
}
display_name: "Attach object to robot"
vendor {
  display_name: "Intrinsic"
}
documentation {
  description:
    "Attaches, or connects, an object to a gripper in the object"
    "world.\n\n"
    "Executing this skill will rigidly attach the object to the gripper in "
    "the object world and disable collision checking between the gripper and the object "
    "(when attaching directly to a robot arm, collisions are only disabled with the arm's "
    "final link). The object will move with the robot.\n\n"
    "This skill will not physically grasp the object in full physics simulation "
    "or when running on hardware."
}
options {
  cancellation_ready_timeout {
    seconds: 30
  }
  cc_config {
    create_skill: "::intrinsic::skills::AttachObjectToRobotSkill::CreateSkill"
  }
}
parameter {
  message_full_name: "intrinsic_proto.skills.AttachObjectToRobotParams"
}
